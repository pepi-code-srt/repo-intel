GEMINI_API_KEY=your_gemini_api_key_here

# Model Configuration (optional — defaults shown)
# Strongest model first. If busy/error, falls through to next.
# GEMINI_MODEL_PRIMARY=gemini-3.5-flash
# GEMINI_MODEL_FAST=gemini-3.1-flash-lite
# GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite

# Optional: Disable fast helper to save one AI call
# ENABLE_FAST_HELPER=false
